<Project>
  <!-- Must run before SDK props (MSB3539). Keep obj/ out of the project tree: BenchmarkDotNet 0.14 uses
       EnumerateFiles(AllDirectories) to find the host .csproj and can hit UnauthorizedAccessException on
       stale or locked obj folders (e.g. after TFM changes). -->
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectFile)').EndsWith('MsSpecification.Benchmarks.csproj'))">
    <BaseIntermediateOutputPath>$([System.IO.Path]::GetTempPath())MsSpecification.Benchmarks\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <!-- BenchmarkDotNet.Autogenerated.csproj under bin/ inherits repo TargetFrameworks (net8;9;10).
       Force a single TFM matching MsSpecification.Benchmarks so restore does not fail (NU1201). -->
  <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectFile)').Contains('BenchmarkDotNet.Autogenerated.csproj'))">
    <TargetFrameworks>net8.0</TargetFrameworks>
  </PropertyGroup>
</Project>
