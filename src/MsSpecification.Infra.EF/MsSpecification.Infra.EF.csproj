<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MsSpecification.Infra.EF</RootNamespace>
    <AssemblyName>MsSpecification.Infra.EF</AssemblyName>
    <PackageId>MsSpecification.EntityFrameworkCore</PackageId>
    <Description>Entity Framework Core integration for MsSpecification — evaluator, repository, and query extensions.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.13" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <MsSpecPublicKey></MsSpecPublicKey>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MsSpecification.Infra.EF.Tests" Key="$(MsSpecPublicKey)" />
    <ProjectReference Include="..\MsSpecification.Core\MsSpecification.Core.csproj" />
    <None Include="../../logo.png" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
