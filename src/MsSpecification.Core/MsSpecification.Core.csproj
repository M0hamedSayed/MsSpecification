<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MsSpecification.Core</RootNamespace>
    <AssemblyName>MsSpecification.Core</AssemblyName>
    <PackageId>MsSpecification.Core</PackageId>
    <Description>Core specification pattern abstractions, base classes, and builders — no EF Core dependency.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Public key derived from MsSpecification.snk. Required for InternalsVisibleTo to friend signed assemblies. -->
    <MsSpecPublicKey></MsSpecPublicKey>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MsSpecification.Core.Tests" Key="$(MsSpecPublicKey)" />
    <InternalsVisibleTo Include="MsSpecification.Infra.EF" Key="$(MsSpecPublicKey)" />
    <None Include="../../logo.png" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
